# Credenciales de SOLO LECTURA para los exportadores de bases de datos.
# Copia a /opt/enterprise-tools/infra-ops-console/infra/bd.env (permisos 600).
# Los usuarios se crean con: sudo bash crear-usuarios-bd.sh

# MySQL (mysqld_exporter)
MYSQLD_EXPORTER_PASSWORD=cambiar

# PostgreSQL (postgres_exporter)
DATA_SOURCE_NAME=postgresql://infra_monitor:cambiar@127.0.0.1:5432/postgres?sslmode=disable

# SQL Server (opcional)
SERVER=127.0.0.1
PORT=1433
USERNAME=infra_monitor
PASSWORD=cambiar
