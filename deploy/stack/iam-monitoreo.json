{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescubrirServidores",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:DescribeTags", "ec2:DescribeVolumes", "ec2:DescribeRegions"],
      "Resource": "*"
    },
    {
      "Sid": "LeerCloudWatch",
      "Effect": "Allow",
      "Action": ["cloudwatch:GetMetricData", "cloudwatch:GetMetricStatistics", "cloudwatch:ListMetrics", "tag:GetResources"],
      "Resource": "*"
    }
  ]
}
