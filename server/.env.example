# Puerto y dirección donde escucha el backend (en producción déjalo en 127.0.0.1 y ponle nginx delante)
PORT=4000
HOST=127.0.0.1

# Prometheus. En tu Mac, con el túnel abierto (npm run tunnel), es http://127.0.0.1:9090
PROM_URL=http://127.0.0.1:9090
# Loki (logs). En desarrollo llega por el túnel SSH.
LOKI_URL=http://127.0.0.1:3100

# Carpeta donde se guarda el estado compartido (hosts ocultos, silencios, auditoría)
# DATA_DIR=./data

# Encabezado HTTP con el usuario autenticado, si nginx lo inyecta (opcional)
# USER_HEADER=x-webauth-user

# Producción: URL interna de Grafana para identificar al usuario en la auditoría (por su sesión)
# GRAFANA_URL=http://127.0.0.1:3001

# --- AWS: facturación y S3 (solo lectura) — usuario IAM "Monitoreo-Facturacion" ---
# Política: deploy/aws/iam-facturacion.json · Guía: docs/aws-facturacion-s3.md
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# Horas que se guardan los datos (Cost Explorer cobra USD 0,01 por consulta)
# AWS_BILLING_CACHE_H=8
# AWS_S3_CACHE_H=1
# Tipo de cambio para ver los costos en pesos: se toma la TRM oficial automáticamente.
# Solo si el servidor no tiene Internet, fija un valor:
# COP_TRM=4000
# Presupuesto mensual inicial en US$ (también se puede definir desde el panel)
# AWS_BUDGET_USD=2000

# NAS Synology por SNMP (solo lectura)
# SYNOLOGY_HOSTS=192.168.10.180=NAS sistemas
# SYNOLOGY_SNMP_USER=monitoreo
# SYNOLOGY_SNMP_AUTH=
# SYNOLOGY_SNMP_PRIV=

# Azure por API (solo lectura, rol Lector)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
